{
  "name": "angular-personal-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "gitleaks-scan": "gitleaks detect --verbose --report-format csv --report-path leaks.csv",
    "gitleaks-scan-redact": "gitleaks detect --verbose --report-format csv --report-path leaks.csv --redact=0",
    "gitleaks-scan-dir": "gitleaks dir . --verbose --report-format csv --report-path leaks.csv",
    "gitleaks-scan-protected": "gitleaks detect --verbose --report-format csv --report-path leaks.csv --staged",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "node dist/angular-personal-homepage/server/server.mjs",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/platform-server": "^20.3.25",
    "@angular/router": "^20.3.25",
    "@angular/ssr": "^20.3.29",
    "prettier": "^3.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.29",
    "@angular/build": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.25",
    "@cypress/schematic": "^4.3.0",
    "@types/express": "^5.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.19.21",
    "angular-eslint": "21.0.1",
    "cypress": "^15.17.0",
    "eslint": "^9.39.4",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "8.46.4"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@babel/plugin-transform-modules-systemjs": "^7.29.0",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.18",
    "ip-address": "^10.1.1",
    "braces": "^3.0.3",
    "minimatch": "^5.1.6",
    "glob": "^8.1.0",
    "semver": "^7.6.3",
    "node-forge": "^1.3.3",
    "tree-kill": "^1.2.2",
    "@babel/core": "^7.26.9",
    "esbuild": "^0.25.0",
    "http-proxy-middleware": "^3.0.7",
    "piscina": "^5.1.5",
    "uuid": "^11.1.1",
    "vite": "^7.0.8"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "cypress@15.17.0": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.7": true,
    "lmdb@3.4.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
